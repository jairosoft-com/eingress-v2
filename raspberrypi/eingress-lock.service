[Unit]
Description=EINGRESS RFID Lock Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/eingress-v2/raspberrypi
EnvironmentFile=/home/pi/eingress-v2/raspberrypi/.env
ExecStart=/home/pi/eingress-v2/raspberrypi/venv/bin/python3 rfid_lock_controller.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
